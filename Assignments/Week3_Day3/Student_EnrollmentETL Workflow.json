    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  try {\n    // Get the AI-generated JSON from the \"text\" field\n    const raw = item.json.text;\n\n    // Parse the JSON string into a proper JSON object\n    const cleanedData = JSON.parse(raw);\n\n    return {\n      json: cleanedData\n    };\n\n  } catch (error) {\n    return {\n      json: {\n        parse_error: true,\n        error: error.message,\n        original_text: item.json.text\n      }\n    };\n  }\n});"
      },
