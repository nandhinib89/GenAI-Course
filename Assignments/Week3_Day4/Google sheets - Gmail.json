    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nlet message = `\n<p style=\"margin: 0 0 20px 0;\">Hi,</p>\n\n<p style=\"margin: 0 0 20px 0;\">\nHere is the latest data from the sheet:\n</p>\n`;\n\nrows.forEach(row => {\n  const name = row.json.Name || '';\n  const course = row.json.Course || '';\n  const feePaid = row.json.Fee_Paid ?? '';\n\n  message += `\n<div style=\"margin-bottom: 20px;\">\n  <div>• Name: ${name}</div>\n  <div>• Course: ${course}</div>\n  <div>• Fee Paid: ${feePaid}</div>\n</div>\n`;\n});\n\nmessage += `\n<p style=\"margin: 0;\">\nRegards,<br>\nYour Automation Bot\n</p>\n`;\n\nreturn [\n  {\n    json: {\n      to: 'nandhinib2105@gmail.com',\n      subject: 'Data Summary from Google Sheet',\n      message: message\n    }\n  }\n];"
      },
